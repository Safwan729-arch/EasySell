# Supabase configuration — copy the values into your --dart-define flags.
# DO NOT commit real keys. Only the anon (public) key belongs on-device;
# the service-role key must stay inside Supabase Edge Functions.
#
# Example run:
#   flutter run \
#     --dart-define=SUPABASE_URL=$SUPABASE_URL \
#     --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
